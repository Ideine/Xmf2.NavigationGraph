<?xml version="1.0" encoding="utf-8"?>
<package>
    <metadata>
        <id>Xmf2.NavigationGraph</id>
        <title>Xmf2.NavigationGraph</title>
        <version>8.0.0</version>
        <authors>Ideine, VJubert</authors>
        <owners>Ideine, VJubert</owners>
        <projectUrl>https://github.com/Ideine/Xmf2.NavigationGraph</projectUrl>
        <license type="file">LICENSE</license>
        <repository url="https://github.com/Ideine/Xmf2.NavigationGraph.git" type="git"/>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>Ideine tools for route navigation with complex graph</description>
        <releaseNotes>Targets net10.0-ios and net10.0-android only (Xamarin and net7 dropped); Fix concurrent navigations disposing the displayed view model; INavigationInProgress.TryCommit to commit atomically against a cancellation; INavigationService.Close(viewModel) closes the screen of a view model and ignores a screen already closed (double tap on a back button)</releaseNotes>
        <copyright>Copyright Ideine 2020</copyright>
        <tags>xmf2 ideine navigationgraph</tags>
        <dependencies>
            <group targetFramework="netstandard2.0">
                <dependency id="Xmf2.DisposableExtensions" version="1.0.0"/>
            </group>
            <group targetFramework="net10.0-android36.0">
                <dependency id="Xmf2.DisposableExtensions" version="1.0.0"/>
                <dependency id="Microsoft.Maui.Essentials" version="10.0.71"/>
                <dependency id="Xamarin.AndroidX.AppCompat" version="1.7.1.3"/>
            </group>
            <group targetFramework="net10.0-ios26.0">
                <dependency id="Xmf2.DisposableExtensions" version="1.0.0"/>
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="src\Xmf2.NavigationGraph.Core\bin\Release\netstandard2.0\*.dll;src\Xmf2.NavigationGraph.Core\bin\Release\netstandard2.0\*.pdb" target="lib\netstandard2.0"/>
        <file src="src\Xmf2.NavigationGraph.Droid\bin\Release\net10.0-android\*.dll;src\Xmf2.NavigationGraph.Droid\bin\Release\net10.0-android\*.pdb" target="lib\net10.0-android36.0"/>
        <file src="src\Xmf2.NavigationGraph.iOS\bin\Release\net10.0-ios\*.dll;src\Xmf2.NavigationGraph.iOS\bin\Release\net10.0-ios\*.pdb" target="lib\net10.0-ios26.0"/>
        <file src="LICENSE"/>
    </files>
</package>